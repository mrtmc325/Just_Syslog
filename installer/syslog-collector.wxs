<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026 Tristan Conner <tristan@conner.house>
     SPDX-License-Identifier: MIT

  WiX v5 source for a single-file x64 MSI. Installs syslogd.exe into Program
  Files, registers the auto-start "SyslogCollector" service, opens inbound
  UDP/514, and writes the chosen log directory to config.txt. Everything is
  declarative, so uninstall removes the service, the firewall rule, and config.

  Build with installer\build-msi.ps1 (which passes ExeSource). The exe path is
  supplied on the command line:  wix build ... -d ExeSource="<path>\syslogd.exe"
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Just Syslog"
           Manufacturer="Tristan Conner"
           Version="1.0.2.0"
           UpgradeCode="4146CA9C-75B3-4F7A-91DE-C0483160F66E"
           Scope="perMachine"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: reinstalling the same version (a rebuilt MSI
         has a new ProductCode but the same version) replaces the existing
         install instead of adding a second Programs-and-Features entry.
         Schedule=afterInstallInitialize moves the removal of the old version
         into the elevated execute phase, so StopSyslogInstance (below) can stop
         the running service + tray before the old files are removed and the new
         ones are laid down. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Just Syslog is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Log directory. Default is %ProgramData%\SyslogCollector\logs — a trusted,
         non-squattable location (matches the binary's own default), unlike a
         drive-root folder which a standard user can pre-create and hijack. It is
         computed after CostFinalize so [CommonAppDataFolder] resolves. Override at
         install time: msiexec /i JustSyslog-1.0.2-x64.msi LOGDIR="D:\SyslogLogs" -->
    <Property Id="LOGDIR" />
    <SetProperty Id="LOGDIR" Value="[CommonAppDataFolder]SyslogCollector\logs"
                 After="CostFinalize" Sequence="both" Condition="NOT LOGDIR" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SyslogCollector">
        <Directory Id="TRAYFOLDER" Name="tray" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="SyslogCollector" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Shortcut icon (Icon table). -->
    <Icon Id="SyslogAppIcon" SourceFile="tray\syslog.ico" />

    <!-- The program + the service + the firewall rule, one component. -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="SyslogdExe" Bitness="always64">
        <File Id="syslogd.exe" Source="$(var.ExeSource)" KeyPath="yes" />

        <ServiceInstall Id="SvcInstall"
                        Name="SyslogCollector"
                        DisplayName="Just Syslog"
                        Description="Collects syslog (UDP/514) from network hosts into local log files and serves a local web viewer."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="service"
                        Vital="yes" />

        <ServiceControl Id="SvcControl"
                        Name="SyslogCollector"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- Inbound UDP/514 allowed on all profiles; removed on uninstall. -->
        <fw:FirewallException Id="Syslog514"
                              Name="Just Syslog UDP 514"
                              Description="Inbound syslog for Just Syslog"
                              Port="514"
                              Protocol="udp"
                              Scope="any" />
      </Component>
    </ComponentGroup>

    <!-- config.txt in %ProgramData%\SyslogCollector. Only log_dir is written;
         ports/retention default in-app when absent. The [syslog] header is
         ignored by the parser (no '='), so this stays valid key=value. -->
    <Component Id="Config" Directory="DATAFOLDER" Guid="6E0E7C7A-4B2C-4E0B-9E4F-2C3D4E5F6A7B">
      <CreateFolder />
      <IniFile Id="CfgLogDir"
               Action="createLine"
               Directory="DATAFOLDER"
               Name="config.txt"
               Section="syslog"
               Key="log_dir"
               Value="[LOGDIR]" />
      <RegistryValue Root="HKLM" Key="Software\SyslogCollector"
                     Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveDataFolder" On="uninstall" />
    </Component>

    <!-- System tray controller (WinForms) + start-at-login. -->
    <Component Id="Tray" Directory="TRAYFOLDER" Bitness="always64"
               Guid="8B7A6C5D-4E3F-4A2B-9C1D-0E9F8A7B6C5D">
      <File Id="SyslogTrayPs1" Source="tray\SyslogTray.ps1" KeyPath="yes" />
      <File Id="SyslogTrayVbs" Source="tray\SyslogTray.vbs" />
      <File Id="SyslogIco"     Source="tray\syslog.ico" />
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="SyslogCollectorTray"
                     Type="string"
                     Value="wscript.exe &quot;[INSTALLFOLDER]tray\SyslogTray.vbs&quot;" />

      <!-- Start Menu + Desktop shortcuts to the tray controller. -->
      <Shortcut Id="StartMenuTray" Directory="ProgramMenuFolder"
                Name="Just Syslog" Description="Open the Just Syslog tray controller"
                Target="[System64Folder]wscript.exe"
                Arguments="&quot;[#SyslogTrayVbs]&quot;"
                WorkingDirectory="TRAYFOLDER" Icon="SyslogAppIcon" />
      <Shortcut Id="DesktopTray" Directory="DesktopFolder"
                Name="Just Syslog" Description="Open the Just Syslog tray controller"
                Target="[System64Folder]wscript.exe"
                Arguments="&quot;[#SyslogTrayVbs]&quot;"
                WorkingDirectory="TRAYFOLDER" Icon="SyslogAppIcon" />
    </Component>

    <Feature Id="Main" Title="Just Syslog" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentRef Id="Config" />
      <ComponentRef Id="Tray" />
    </Feature>

    <!-- On upgrade/reinstall, stop the running instance BEFORE the old payload
         is removed and the new one is laid down: Stop-Service waits for the
         service to actually stop (frees UDP/514 + syslogd.exe), then the tray
         controller process is killed by command-line match (frees the tray
         files + clears the stale icon). Deferred + no impersonation => runs
         elevated as SYSTEM; best-effort (Return=ignore) so it never blocks. -->
    <!-- Command is intentionally brace-free: MSI Formatted fields treat {} and
         [] as special, so the tray is matched with chained Where-Object and
         killed with Invoke-CimMethod Terminate (no script blocks, no $_). -->
    <CustomAction Id="StopSyslogInstance"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;Stop-Service -Name SyslogCollector -Force -ErrorAction SilentlyContinue; Get-CimInstance Win32_Process | Where-Object Name -eq 'powershell.exe' | Where-Object CommandLine -like '*\tray\SyslogTray.ps1*' | Invoke-CimMethod -MethodName Terminate -ErrorAction SilentlyContinue&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Start the tray now (in the installing user's session) on a fresh
         install, so the icon appears without waiting for the next login. -->
    <CustomAction Id="LaunchTray"
                  Directory="TRAYFOLDER"
                  ExeCommand="wscript.exe &quot;[TRAYFOLDER]SyslogTray.vbs&quot;"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="StopSyslogInstance" Before="RemoveExistingProducts"
              Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>
</Wix>
